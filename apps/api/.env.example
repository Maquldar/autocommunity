# AutoCommunity API — every variable is validated at boot (src/config/env.ts); invalid config fails fast.

# --- runtime
NODE_ENV=development                  # development | test | production
API_PORT=4000
LOG_LEVEL=info                        # fatal | error | warn | info | debug | trace | silent
# Comma-separated browser origins allowed by CORS (credentials enabled).
WEB_ORIGIN=http://localhost:3000
# Express "trust proxy": false (default), a hop count, or subnet names/CIDRs. Determines req.ip for rate
# limits. In production behind a load balancer set the exact hop count (e.g. 1); never trust more hops
# than you have, or clients can spoof X-Forwarded-For.
TRUST_PROXY=false

# --- data stores
DATABASE_URL=postgresql://autoc:autoc@localhost:5432/autoc
REDIS_URL=redis://localhost:6379

# --- auth (generate secrets with: openssl rand -base64 48)
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
OTP_SECRET=change-me-to-another-random-string-of-32-chars
# Secure flag on auth cookies; defaults to true when NODE_ENV=production.
COOKIE_SECURE=
# Set when web and API are on sibling subdomains (e.g. .example.com) so the web app can read ac_csrf.
COOKIE_DOMAIN=

# --- SMS / OTP
SMS_PROVIDER=console                  # console (logs the code) | twilio
# Return the OTP in the /auth/otp/request response. Only honoured with SMS_PROVIDER=console; refused in production.
AUTH_EXPOSE_DEV_CODE=true
# Global circuit breaker on SMS sends per hour.
OTP_GLOBAL_PER_HOUR=2000
# Only these E.164 prefixes may receive OTP SMS (premium-rate toll-fraud protection). Comma-separated.
OTP_ALLOWED_PREFIXES=+7
# The console sender is refused when NODE_ENV=production unless this is true.
ALLOW_CONSOLE_SMS=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 sender number or Messaging Service SID (MG...)
TWILIO_FROM=

# --- social sign-in (each provider is enabled only when its client id is set)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=                      # Services ID used by Sign in with Apple JS
APPLE_REDIRECT_URI=                   # required when APPLE_CLIENT_ID is set

# --- file storage
STORAGE_DRIVER=local                  # local | s3 (MinIO, Cloudflare R2, AWS S3)
UPLOAD_DIR=./uploads-data             # local driver only; served by the API at /media/*
PUBLIC_MEDIA_URL=http://localhost:4000/media   # public base URL of stored objects (no trailing slash)
# S3/R2: objects are written with Content-Type and Content-Disposition: inline. The CDN / public bucket in
# front of them must add `X-Content-Type-Options: nosniff` (R2/S3 can't set it per object).
S3_ENDPOINT=                          # e.g. http://localhost:9000 (MinIO) or https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
